@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<style>
    .auth-wrapper {
        width: min(700px, 90%);
        margin: 4rem auto;
        padding: 2.5rem;
        border: 1px solid #ddd;
        background: #fff;
        border-radius: 0;
    }

    .auth-title {
        font-size: 1.8rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        letter-spacing: 1px;
    }

    .auth-subtitle {
        color: #666;
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
    }

    .form-floating > label {
        padding-left: 0.75rem;
    }

    .divider {
        text-align: center;
        margin: 2rem 0;
        position: relative;
    }

        .divider::before,
        .divider::after {
            content: "";
            height: 1px;
            width: 40%;
            background: #ddd;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
        }

        .divider::before {
            left: 0;
        }

        .divider::after {
            right: 0;
        }

        .divider span {
            padding: 0 10px;
            color: #777;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

    .provider-btn {
        width: 100%;
        margin-bottom: 0.5rem;
        border-radius: 0;
    }
</style>

<div class="auth-wrapper">

    <h2 class="auth-title">Create Account</h2>
    <p class="auth-subtitle">Join us and start exploring books instantly.</p>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <!-- Account Section -->
        <h5 class="fw-semibold mb-3">Account Details</h5>

        <div class="row g-4 mb-4">
            <div class="col-md-12">
                <div class="form-floating">
                    <input asp-for="Input.Name" class="form-control" placeholder="email@example.com" />
                    <label asp-for="Input.Name"></label>
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-12">
                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" placeholder="email@example.com" />
                    <label asp-for="Input.Email"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Input.Password" class="form-control" placeholder="Password" />
                    <label asp-for="Input.Password"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                    <label asp-for="Input.ConfirmPassword"></label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
        </div>


        <!-- Address Section -->
        <h5 class="fw-semibold mb-3">Address Information</h5>

        <div class="row g-4 mb-4">

            <div class="col-md-12">
                <div class="form-floating">
                    <input asp-for="Input.StreetAddress" class="form-control" placeholder="Street Address" />
                    <label asp-for="Input.StreetAddress"></label>
                    <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="Input.City" class="form-control" placeholder="City" />
                    <label asp-for="Input.City"></label>
                    <span asp-validation-for="Input.City" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="Input.State" class="form-control" placeholder="State" />
                    <label asp-for="Input.State"></label>
                    <span asp-validation-for="Input.State" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="Input.PostalCode" class="form-control" placeholder="Postal Code" />
                    <label asp-for="Input.PostalCode"></label>
                    <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Phone Number" />
                    <label asp-for="Input.PhoneNumber"></label>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select"></select>
                    <label asp-for="Input.Role">Select Role</label>
                </div>
            </div>
        </div>


        <button id="registerSubmit" type="submit" class="btn btn-dark w-100 py-2 rounded-0 fw-bold text-uppercase">
            Create Account
        </button>

    </form>


    <div class="divider">
        <span>Or</span>
    </div>

    <!-- External Logins -->
    @{
        if ((Model.ExternalLogins?.Count ?? 0) == 0)
        {
            <p class="text-muted small">
                No external authentication services configured.
            </p>
        }
        else
        {
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="btn btn-outline-secondary provider-btn"
                            name="provider"
                            value="@provider.Name">
                        Continue with @provider.DisplayName
                    </button>
                }

            </form>
        }
    }

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
