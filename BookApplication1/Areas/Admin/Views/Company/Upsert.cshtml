@model Company

@{
    ViewData["Title"] = "Upsert Company";
    bool isUpdate = Model.Id != 0;
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            @(isUpdate ? "Update Company" : "Add New Company")
        </h2>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Upsert" method="post">

                <input asp-for="Id" hidden />

                <!-- Company Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter company name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Street Address -->
                <div class="mb-3">
                    <label asp-for="StreetAddress" class="form-label fw-semibold"></label>
                    <input asp-for="StreetAddress" class="form-control" placeholder="Street address" />
                    <span asp-validation-for="StreetAddress" class="text-danger"></span>
                </div>

                <!-- City - State - Postal Code -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control" placeholder="City" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="State" class="form-label fw-semibold"></label>
                        <input asp-for="State" class="form-control" placeholder="State" />
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="PostalCode" class="form-label fw-semibold"></label>
                        <input asp-for="PostalCode" class="form-control" placeholder="Postal code" />
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>
                </div>

                <!-- Phone Number -->
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-dark px-4">
                        @(isUpdate ? "Save Changes" : "Create Company")
                    </button>

                    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
