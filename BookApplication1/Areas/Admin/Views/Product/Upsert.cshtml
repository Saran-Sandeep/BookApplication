@model ProductVM

@{
    ViewData["Title"] = "Upsert Product";
    // Initials Placeholder Logic
    var initials = "BK";
    if (!string.IsNullOrWhiteSpace(Model.Product.Name))
    {
        var parts = Model.Product.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = string.Concat(parts.Select(x => x[0])).ToUpper();
        if (initials.Length > 2) initials = initials.Substring(0, 2);
    }
}

<div class="container mt-5">

    <h2 class="mb-4 fw-bold text-uppercase border-bottom pb-2">
        @(Model.Product.Id == 0 ? "Add New Product" : "Update Product")
    </h2>

    <form asp-action="Upsert" method="post" class="row g-4" enctype="multipart/form-data">
        <input asp-for="Product.Id" hidden/>
        <input asp-for="Product.ImageURL" hidden/>

        <div class="row" >
            <!-- LEFT SIDE: FORM -->
            <div class="col-md-8">

                <!-- Book Name -->
                <div class="mb-3">
                    <label asp-for="Product.Name" class="form-label"></label>
                    <input asp-for="Product.Name" class="form-control" />
                    <span asp-validation-for="Product.Name" class="text-danger"></span>
                </div>

                <!-- Author -->
                <div class="mb-3">
                    <label asp-for="Product.Author" class="form-label"></label>
                    <input asp-for="Product.Author" class="form-control" />
                    <span asp-validation-for="Product.Author" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Product.Description" class="form-label"></label>
                    <textarea asp-for="Product.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Product.Description" class="text-danger"></span>
                </div>

                <!-- The rest of your form remains same -->
            </div>

            <!-- RIGHT SIDE — IMAGE ONLY IN UPDATE -->
            @if (Model.Product.Id != 0)
            {
                <div class="col-lg-4">
                    <div class="border p-3 text-center" style="height: 300px; overflow:hidden;">

                        @if (!string.IsNullOrEmpty(Model.Product.ImageURL))
                        {
                            <!-- SHOW REAL IMAGE -->
                            <img src="@Url.Content("~/" + Model.Product.ImageURL)"
                                 alt="@Model.Product.Name"
                                 class="h-100 w-100 object-fit-cover" />
                        }
                        else
                        {
                            <!-- SHOW PLACEHOLDER INITIALS -->
                            <div class="d-flex flex-column justify-content-center align-items-center h-100 bg-light">
                                <h1 class="display-3 fw-bold opacity-25" style="font-family: serif;">@initials</h1>
                                <span class="text-muted">@Model.Product.Author</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

      @*   <!-- Book Name -->
        <div class="col-md-6">
            <label asp-for="Product.Name" class="form-label"></label>
            <input asp-for="Product.Name" class="form-control" />
            <span asp-validation-for="Product.Name" class="text-danger"></span>
        </div>

        <!-- Author Name -->
        <div class="col-md-6">
            <label asp-for="Product.Author" class="form-label"></label>
            <input asp-for="Product.Author" class="form-control" />
            <span asp-validation-for="Product.Author" class="text-danger"></span>
        </div>

        <!-- Description -->
        <div class="col-12">
            <label asp-for="Product.Description" class="form-label"></label>
            <textarea asp-for="Product.Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Product.Description" class="text-danger"></span>
        </div> *@

        <!-- Price -->
        <div class="col-md-4">
            <label asp-for="Product.Price" class="form-label"></label>
            <input asp-for="Product.Price" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Product.Price" class="text-danger"></span>
        </div>

        <!-- Stock Quantity -->
        <div class="col-md-4">
            <label asp-for="Product.Quantity" class="form-label"></label>
            <input asp-for="Product.Quantity" type="number" class="form-control" />
            <span asp-validation-for="Product.Quantity" class="text-danger"></span>
        </div>

        <!-- Edition Number -->
        <div class="col-md-4">
            <label asp-for="Product.EditionNum" class="form-label"></label>
            <input asp-for="Product.EditionNum" type="number" class="form-control" />
            <span asp-validation-for="Product.EditionNum" class="text-danger"></span>
        </div>

        <!-- Published Date (DateOnly) -->
        <div class="col-md-4">
            <label asp-for="Product.PublishedDate" class="form-label"></label>
            <input asp-for="Product.PublishedDate" type="date" class="form-control" />

            <span asp-validation-for="Product.PublishedDate" class="text-danger"></span>
        </div>

        <!-- Rating -->
        <div class="col-md-4">
            <label asp-for="Product.Rating" class="form-label"></label>
            <input asp-for="Product.Rating" type="number" min="1" max="5" class="form-control" />
            <span asp-validation-for="Product.Rating" class="text-danger"></span>
        </div>

        <!-- ISBN -->
        <div class="col-md-4">
            <label asp-for="Product.ISBN" class="form-label"></label>
            <input asp-for="Product.ISBN" class="form-control" />
            <span asp-validation-for="Product.ISBN" class="text-danger"></span>
        </div>

        <!-- Categories -->
        <div class="col-md-6">
            <label asp-for="Product.CategoryId" class="form-label"></label>
            <select asp-for="Product.CategoryId" class="form-control form-select" asp-items="@Model.CategoryList">
                <option disabled selected>---Select Category---</option>
            </select>
            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
        </div>

        <!-- ImageURL -->
        <div class="col-md-6">
            <label asp-for="Product.ImageURL" class="form-label"></label>
            <input asp-for="Product.ImageURL" class="form-control" type="file" name="formFile"/>
        </div>

        @* <!-- Created At -->
        <div class="col-md-6">
            <label asp-for="CreatedAt" class="form-label"></label>
            <input asp-for="CreatedAt" type="date" class="form-control"
                   value="@Model.CreatedAt.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="CreatedAt" class="text-danger"></span>
        </div>

        <!-- Updated At -->
        <div class="col-md-6">
            <label asp-for="UpdatedAt" class="form-label"></label>
            <input asp-for="UpdatedAt" type="date" class="form-control"
                   value="@Model.UpdatedAt.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="UpdatedAt" class="text-danger"></span>
        </div> *@

        <!-- Submit -->
        <div class="col-12 mt-3 d-flex justify-content-end">
            <button type="submit" class="btn btn-primary px-4">@(Model.Product.Id == 0 ? "Add Product" : "Save Changes")</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
