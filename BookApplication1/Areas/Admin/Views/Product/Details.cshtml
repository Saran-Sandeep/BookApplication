@model Product

@{
    ViewData["Title"] = "Book Details (Admin)";
}

<style>
    .detail-card {
        border: 1px solid #ddd;
        border-radius: 0;
        padding: 2rem;
        background: #fff;
    }

    .book-cover {
        height: 300px;
        border: 1px solid #ddd;
        border-radius: 0;
        overflow: hidden;
        background: #f8f8f8;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .book-cover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .book-initials {
        font-size: 4rem;
        font-weight: bold;
        color: #888;
        font-family: serif;
    }

    .line {
        height: 1px;
        background: #e0e0e0;
        margin: 1.2rem 0;
    }

    .category-chip {
        display: inline-block;
        padding: 4px 10px;
        font-size: 0.75rem;
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        color: #3746ad;
        border-radius: 20px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>


<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold tracking-wide">Book Details</h2>

        <a asp-action="Index" class="btn btn-secondary rounded-0 text-uppercase">
            ← Back to List
        </a>
    </div>

    <div class="row g-4">

        <!-- Left Column -->
        <div class="col-md-4">

            <div class="book-cover">
                @if (!string.IsNullOrEmpty(Model.ImageURL))
                {
                    <img src="@Url.Content("~/" + Model.ImageURL)" alt="@Model.Name" />
                }
                else
                {
                    <div class="book-initials">
                        @Model.Name.Substring(0, 1).ToUpper()
                    </div>
                }
            </div>

            <!-- Stock Badge -->
            <div class="mt-3">
                @if (Model.Quantity == 0)
                {
                    <span class="badge bg-danger px-3 py-2">Out of Stock</span>
                }
                else if (Model.Quantity <= 5)
                {
                    <span class="badge bg-warning text-dark px-3 py-2">Low Stock</span>
                }
                else
                {
                    <span class="badge bg-success px-3 py-2">In Stock</span>
                }
            </div>

        </div>

        <!-- Right Column -->
        <div class="col-md-8">

            <div class="detail-card">

                <h3 class="fw-bold text-uppercase mb-2">@Model.Name</h3>
                <p class="text-muted mb-2">by @Model.Author</p>

                <span class="category-chip">@Model.Category.Name</span>

                <!-- Rating -->
                <div class="mt-3 mb-3">
                    @{
                        int rating = Math.Clamp(Model.Rating, 0, 5);
                        for (int i = 0; i < 5; i++)
                        {
                            <i class="bi @(i < rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                        }
                    }
                </div>

                <div class="line"></div>

                <!-- Description -->
                <h6 class="fw-bold text-uppercase small">Description</h6>
                <p class="text-muted" style="font-family: serif;">
                    @Model.Description
                </p>

                <div class="line"></div>

                <!-- Admin Table -->
                <table class="table table-borderless small">
                    <tr><th class="text-muted">Price</th><td>₹@Model.Price</td></tr>
                    <tr><th class="text-muted">Published</th><td>@Model.PublishedDate.Year</td></tr>
                    <tr><th class="text-muted">Edition</th><td>@Model.EditionNum</td></tr>
                    <tr><th class="text-muted">ISBN</th><td>@Model.ISBN</td></tr>
                    <tr><th class="text-muted">Category</th><td>@Model.Category.Name</td></tr>
                    <tr><th class="text-muted">Quantity</th><td>@Model.Quantity</td></tr>
                    <tr><th class="text-muted">Created</th><td>@Model.CreatedAt</td></tr>
                    <tr><th class="text-muted">Last Updated</th><td>@Model.UpdatedAt</td></tr>
                </table>

                <div class="line"></div>

                <!-- Admin Actions -->
                <div class="d-flex gap-3">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-dark rounded-0 text-uppercase px-4">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this book?')">
                        <button type="submit" class="btn btn-danger rounded-0 text-uppercase px-4">
                            Delete
                        </button>
                    </form>
                </div>

            </div>

        </div>

    </div>

</div>
