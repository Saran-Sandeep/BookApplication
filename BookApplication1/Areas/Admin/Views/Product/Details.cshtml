@model Product

@{
    ViewData["Title"] = "Book Details";
}

<style>
    .detail-card {
        border: 1px solid #ddd;
        border-radius: 0;
        padding: 2rem;
        background: #fff;
    }

    .book-cover-placeholder {
        height: 260px;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: bold;
        color: #777;
        border: 1px solid #ddd;
        border-radius: 0;
    }

    .line {
        height: 1px;
        background: #e0e0e0;
        margin: 1.2rem 0;
    }
</style>

<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold tracking-wide">Book Details</h2>

        <a asp-action="Index" class="btn btn-secondary rounded-0 text-uppercase">
            ← Back to List
        </a>
    </div>

    <div class="row g-4">

        <!-- Left Side: Fake Cover -->
        <div class="col-md-4">
            <div class="book-cover-placeholder">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>

            <!-- Stock Info -->
            <div class="mt-3">
                @if (Model.Quantity == 0)
                {
                    <span class="badge bg-danger px-3 py-2">Out of Stock</span>
                }
                else if (Model.Quantity <= 5)
                {
                    <span class="badge bg-warning text-dark px-3 py-2">Low Stock</span>
                }
                else
                {
                    <span class="badge bg-success px-3 py-2">In Stock</span>
                }
            </div>
        </div>

        <!-- Right Side -->
        <div class="col-md-8">
            <div class="detail-card">

                <h3 class="fw-bold text-uppercase mb-2">@Model.Name</h3>
                <p class="text-muted mb-3">by @Model.Author</p>

                <!-- Rating -->
                <div class="mb-3">
                    @{
                        int rating = Math.Clamp(Model.Rating, 0, 5);
                        for (int i = 0; i < 5; i++)
                        {
                            <i class="bi @(i < rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                        }
                    }
                </div>

                <div class="line"></div>

                <!-- Description -->
                <h6 class="fw-bold text-uppercase small">Description</h6>
                <p class="text-muted" style="font-family: serif;">
                    @Model.Description
                </p>

                <div class="line"></div>

                <!-- Information Table -->
                <h6 class="fw-bold text-uppercase small mb-3">Book Information</h6>

                <table class="table table-borderless small">
                    <tr>
                        <th class="text-muted">Price</th>
                        <td>₹@Model.Price</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Published Year</th>
                        <td>@Model.PublishedDate.Year</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Edition</th>
                        <td>@Model.EditionNum</td>
                    </tr>
                    <tr>
                        <th class="text-muted">ISBN</th>
                        <td>@Model.ISBN</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Quantity</th>
                        <td>@Model.Quantity</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Created</th>
                        <td>@Model.CreatedAt</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Last Updated</th>
                        <td>@Model.UpdatedAt</td>
                    </tr>
                </table>

                <div class="line"></div>

                <!-- Action Buttons -->
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-dark rounded-0 text-uppercase px-4">
                        Edit
                    </a>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this product?')">
                        <button type="submit" class="btn btn-danger rounded-0 text-uppercase px-4">
                            Delete
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
