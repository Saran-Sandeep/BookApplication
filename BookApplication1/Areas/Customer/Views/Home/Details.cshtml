@model Product

@{
    ViewData["Title"] = "Book Details";
}

<style>
    .detail-card {
        border: 1px solid #ddd;
        border-radius: 0;
        padding: 2rem;
        background: #fff;
    }

    .book-cover {
        height: 300px;
        border: 1px solid #ddd;
        border-radius: 0;
        overflow: hidden;
        background: #f8f8f8;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .book-cover img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .book-initials {
        font-size: 4rem;
        font-weight: bold;
        color: #888;
        font-family: serif;
    }

    .line {
        height: 1px;
        background: #e0e0e0;
        margin: 1.2rem 0;
    }

    .category-chip {
        display: inline-block;
        padding: 4px 10px;
        font-size: 0.75rem;
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        color: #3746ad;
        border-radius: 20px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .qty-box {
        width: 60px;
        text-align: center;
        border-radius: 0;
    }

    .qty-btn {
        width: 38px;
        height: 38px;
        border-radius: 0;
        padding: 0;
        font-size: 1.4rem; /* optional: makes + and − look balanced */
        line-height: 38px; /* This centers the minus perfectly */
    }


</style>


<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold tracking-wide">Book Details</h2>

        <a asp-action="Index" class="btn btn-secondary rounded-0 text-uppercase">
            ← Back to Library
        </a>
    </div>

    <div class="row g-4">

        <!-- Left Side -->
        <div class="col-md-4">

            <div class="book-cover">
                @if (!string.IsNullOrEmpty(Model.ImageURL))
                {
                    <img src="@Url.Content("~/" + Model.ImageURL)" alt="@Model.Name" />
                }
                else
                {
                    <div class="book-initials">
                        @Model.Name.Substring(0, 1).ToUpper()
                    </div>
                }
            </div>

            <!-- Stock Badge -->
            <div class="mt-3">
                @if (Model.Quantity == 0)
                {
                    <span class="badge bg-danger px-3 py-2">Out of Stock</span>
                }
                else if (Model.Quantity <= 5)
                {
                    <span class="badge bg-warning text-dark px-3 py-2">Low Stock</span>
                }
                else
                {
                    <span class="badge bg-success px-3 py-2">In Stock</span>
                }
            </div>

        </div>

        <!-- Right Side -->
        <div class="col-md-8">
            <div class="detail-card">

                <h3 class="fw-bold text-uppercase mb-2">@Model.Name</h3>
                <p class="text-muted mb-2">by @Model.Author</p>

                <span class="category-chip">@Model.Category.Name</span>

                <!-- Rating -->
                <div class="mt-3 mb-3">
                    @{
                        int rating = Math.Clamp(Model.Rating, 0, 5);
                        for (int i = 0; i < 5; i++)
                        {
                            <i class="bi @(i < rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                        }
                    }
                </div>

                <div class="line"></div>

                <!-- Description -->
                <h6 class="fw-bold text-uppercase small">Description</h6>
                <p class="text-muted" style="font-family: serif;">
                    @Model.Description
                </p>

                <div class="line"></div>

                <!-- Table -->
                <table class="table table-borderless small">
                    <tr><th class="text-muted">Price</th><td>₹@Model.Price</td></tr>
                    <tr><th class="text-muted">Published</th><td>@Model.PublishedDate.Year</td></tr>
                    <tr><th class="text-muted">Edition</th><td>@Model.EditionNum</td></tr>
                    <tr><th class="text-muted">ISBN</th><td>@Model.ISBN</td></tr>
                    <tr><th class="text-muted">Quantity</th><td>@Model.Quantity</td></tr>
                </table>

                <div class="line"></div>

                <!-- Add to Cart Section -->
                @if (Model.Quantity > 0)
                {
                    <form asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" method="post">
                        <div class="d-flex justify-content-between align-content-center gap-3">

                            <div class="d-flex align-items-center gap-2">

                                <button type="button" class="btn btn-outline-dark qty-btn" onclick="updateQty(-1)">−</button>

                                <input type="text" id="qtyInput" name="quantity" value="1" class="form-control qty-box" />

                                <button type="button" class="btn btn-outline-dark qty-btn" onclick="updateQty(1)">+</button>
                            </div>

                            <button type="submit" class="btn btn-dark rounded-0 px-4 py-2 text-uppercase fw-bold">
                                Add to Cart
                            </button>

                        </div>
                    </form>
                }
                else
                {
                    <button class="btn btn-outline-secondary rounded-0 px-4 py-2 text-uppercase" disabled>
                        Out of Stock
                    </button>
                }

            </div>
        </div>
    </div>
</div>

<script>
    function updateQty(change) {
        let qty = document.getElementById("qtyInput");
        let value = parseInt(qty.value) + change;

        if (value < 1) value = 1; // prevent zero or negative
        qty.value = value;
    }
</script>

