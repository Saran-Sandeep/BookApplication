@model IEnumerable<Product>

@{
    ViewData["Title"] = "Home Page";
}

<style>
    /* Card Styling */
    .card-lux {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 0 !important;
        transition: all 0.25s ease;
    }

        .card-lux:hover {
            border-color: #000;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }

    /* Admin buttons */
    .admin-actions-container {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        z-index: 5;
    }

    .btn-admin-square {
        width: 34px;
        height: 34px;
        border-radius: 0 !important;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .card-lux:hover .btn-admin-square {
        opacity: 1;
    }

    /* Image wrappers */
    .book-img-wrapper {
        height: 240px;
        overflow: hidden;
        background: #f8f8f8;
        border-bottom: 1px solid #eee;
        position: relative;
    }

    .placeholder-initials {
        font-family: serif;
        font-weight: 700;
        font-size: 3.5rem;
        opacity: 0.2;
        user-select: none;
    }

    /* Category badge */
    .badge-category {
        background: #f5f5f5;
        color: #222;
        padding: 4px 10px;
        font-size: 0.7rem;
        text-transform: uppercase;
        border-radius: 3px;
        letter-spacing: 0.7px;
    }


    /* Typography helpers */
    .tracking-wide {
        letter-spacing: 2px;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Out of Stock Overlay */
    .out-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        background: rgba(0,0,0,0.75);
        color: #fff;
        text-align: center;
        padding: 7px 0;
        letter-spacing: 2px;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

</style>

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-end mb-5 border-bottom pb-3">
        <div>
            <h2 class="text-uppercase tracking-wide mb-0">Library</h2>
        </div>

        @* <a asp-controller="Product" asp-action="Upsert"
           class="btn btn-primary rounded-0 text-uppercase" style="font-size: 0.8rem;">
            <i class="bi bi-plus-circle me-2"></i> Add Product
        </a> *@
    </div>

    <!-- Search Bar -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <form asp-action="Index" method="get">
                <div class="input-group">
                    <input class="form-control rounded-0 border-secondary"
                           name="searchQuery"
                           placeholder="SEARCH TITLE OR AUTHOR..." />
                    <button class="btn btn-dark rounded-0 px-4 text-uppercase" type="submit">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Book Grid -->
    <div class="row g-4">
        @foreach (var p in Model.OrderBy(p => p.Name))
        {
            var inStock = p.Quantity > 0;

            // Book Initials
            var initials = "BK";
            if (!string.IsNullOrWhiteSpace(p.Name))
            {
                var parts = p.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                initials = string.Concat(parts.Select(x => x[0])).ToUpper();
                if (initials.Length > 2) initials = initials[..2];
            }

            <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex">

                <div class="card card-lux w-100 position-relative">

                    <!-- Admin Buttons -->
                    @* <div class="admin-actions-container">
                        <a asp-controller="Product"
                           asp-action="Upsert"
                           asp-route-productId="@p.Id"
                           class="btn btn-admin-square btn-dark text-white">
                            <i class="bi bi-pencil-fill"></i>
                        </a>

                        <form asp-controller="Product"
                              asp-action="Delete"
                              asp-route-id="@p.Id"
                              method="post"
                              onsubmit="return confirm('Delete this product?');">
                            <button type="submit" class="btn btn-admin-square btn-danger text-white">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div> *@

                    <!-- Image -->
                    <div class="book-img-wrapper">
                        @if (!string.IsNullOrEmpty(p.ImageURL))
                        {
                            <img src="@Url.Content("~/" + p.ImageURL)"
                                 alt="@p.Name"
                                 class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            <div class="h-100 d-flex flex-column justify-content-center align-items-center">
                                <div class="placeholder-initials">@initials</div>
                                <span class="small text-uppercase fw-bold opacity-50">@p.Author</span>
                            </div>
                        }

                        @if (!inStock)
                        {
                            <div class="out-overlay">Out of Stock</div>
                        }
                    </div>

                    <!-- Body -->
                    <div class="card-body d-flex flex-column p-4">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@p.Id"
                           class="text-decoration-none text-dark stretched-link">
                            <h6 class="text-uppercase fw-bold mb-2 text-truncate">@p.Name</h6>
                        </a>

                        <span class="badge-category mb-2">@p.Category.Name</span>

                        <!-- Rating + Year -->
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                            <div class="text-warning small">
                                @{
                                    int r = Math.Clamp(p.Rating, 0, 5);
                                    for (int i = 0; i < 5; i++)
                                    {
                                        <i class="bi @(i < r ? "bi-star-fill" : "bi-star text-muted opacity-25")"></i>
                                    }
                                }
                            </div>
                            <span class="text-muted small">@p.PublishedDate.Year</span>
                        </div>

                        <p class="text-muted small line-clamp-2 mb-4" style="font-family: serif;">
                            @p.Description
                        </p>

                        <!-- Price + Cart -->
                        <div class="mt-auto d-flex justify-content-between">
                            <span class="fw-bold fs-5">₹@p.Price</span>

                            <form asp-controller="Cart" asp-action="Add" asp-route-id="@p.Id" method="post">
                                <button type="submit"
                                        class="btn btn-sm @(inStock ? "btn-outline-dark" : "btn-outline disabled") rounded-0 text-uppercase fw-bold px-3">
                                    @(inStock ? "Add To Cart" : "Sold")
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>
