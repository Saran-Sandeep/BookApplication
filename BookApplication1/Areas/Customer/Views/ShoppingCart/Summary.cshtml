@model OrderSummaryVM

@{
    ViewData["Title"] = "Order Summary";
    var items = Model.ShoppingCartList;
    var total = Model.OrderTotal;
}

<style>
    .summary-wrapper {
        max-width: 950px;
        margin: 3rem auto;
    }

    .section-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 0;
        padding: 1.8rem;
        margin-bottom: 1.5rem;
    }

    .summary-title {
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 1rem;
    }

    .item-row {
        border-bottom: 1px solid #e5e5e5;
        padding: 1rem 0;
    }

        .item-row:last-child {
            border-bottom: none;
        }

    .item-img {
        width: 70px;
        height: 90px;
        border: 1px solid #ddd;
        background: #f8f8f8;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .item-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .initial {
        font-size: 1.8rem;
        font-family: serif;
        color: #888;
        font-weight: bold;
    }

    .line {
        height: 1px;
        background: #e0e0e0;
        margin: 1rem 0;
    }

    .total-box {
        font-size: 1.15rem;
        font-weight: 700;
    }
</style>


<div class="summary-wrapper">

    <h2 class="fw-bold text-uppercase mb-4">Order Summary</h2>

    <!-- 1. Order Items Section -->
    <div class="section-card">
        <h5 class="summary-title">Items in Your Order</h5>

        @foreach (var item in items)
        {
            <div class="row item-row align-items-center">

                <div class="col-auto">
                    <div class="item-img">
                        @if (!string.IsNullOrEmpty(item.Product.ImageURL))
                        {
                            <img src="@Url.Content("~/" + item.Product.ImageURL)" alt="">
                        }
                        else
                        {
                            <div class="initial">
                                @item.Product.Name.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </div>
                </div>

                <div class="col">
                    <div class="fw-bold text-uppercase">@item.Product.Name</div>
                    <div class="small text-muted">by @item.Product.Author</div>
                    <div class="small">Qty: @item.count</div>
                </div>

                <div class="col-auto fw-bold">
                    ₹@(item.count* item.Product.Price)
                </div>

            </div>
        }
    </div>


    <!-- 2. Shipping Details (Editable) -->
    <div class="section-card" id="shippingCard">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="summary-title">Shipping Information</h5>
            <button type="button" id="editAddressBtn" class="btn btn-sm btn-outline-dark rounded-0">
                Edit
            </button>
        </div>

        <!-- Display Mode -->
        <div id="shippingDisplay">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1"><strong>Name:</strong> @Model.User.Name</p>
                    <p class="mb-1"><strong>Email:</strong> @Model.User.Email</p>
                    <p class="mb-1"><strong>Phone:</strong> @Model.User.PhoneNumber</p>
                </div>

                <div class="col-md-6">
                    <p class="mb-1"><strong>Address:</strong> @Model.User.StreetAddress</p>
                    <p class="mb-1"><strong>City:</strong> @Model.User.City</p>
                    <p class="mb-1"><strong>State:</strong> @Model.User.State</p>
                    <p class="mb-1"><strong>Postal Code:</strong> @Model.User.PostalCode</p>
                </div>
            </div>
        </div>


        <!-- Edit Mode (Hidden Until Button Click) -->
        <form asp-action="UpdateAddress" asp-controller="Checkout" method="post" id="shippingForm" style="display:none;">
            <input type="hidden" asp-for="User.Id" />

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="User.Name" class="form-control rounded-0" />
                        <label asp-for="User.Name"></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="User.Email" class="form-control rounded-0" />
                        <label asp-for="User.Email"></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="User.PhoneNumber" class="form-control rounded-0" />
                        <label asp-for="User.PhoneNumber"></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="User.StreetAddress" class="form-control rounded-0" />
                        <label asp-for="User.StreetAddress"></label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating">
                        <input asp-for="User.City" class="form-control rounded-0" />
                        <label asp-for="User.City"></label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating">
                        <input asp-for="User.State" class="form-control rounded-0" />
                        <label asp-for="User.State"></label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating">
                        <input asp-for="User.PostalCode" class="form-control rounded-0" />
                        <label asp-for="User.PostalCode"></label>
                    </div>
                </div>

            </div>

            <div class="mt-3 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary rounded-0" id="cancelEditBtn">Cancel</button>
                <button type="submit" class="btn btn-dark rounded-0">Save Address</button>
            </div>

        </form>

    </div>



    <!-- 3. Payment Summary -->
    <div class="section-card">

        <h5 class="summary-title">Payment Summary</h5>

        <div class="d-flex justify-content-between mb-1">
            <span>Items Subtotal</span>
            <span>₹@total</span>
        </div>

        <div class="d-flex justify-content-between mb-1">
            <span>Shipping</span>
            <span>₹0</span>
        </div>

        <div class="line"></div>

        <div class="d-flex justify-content-between total-box">
            <span>Total Amount</span>
            <span>₹@total</span>
        </div>

        <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" class="mt-4">
            <button type="submit"
                    class="btn btn-dark w-100 py-2 text-uppercase fw-bold rounded-0">
                Confirm & Place Order
            </button>
        </form>

    </div>
</div>


@section Scripts {
    <script>
        const editBtn = document.getElementById("editAddressBtn");
        const displayBox = document.getElementById("shippingDisplay");
        const formBox = document.getElementById("shippingForm");
        const cancelBtn = document.getElementById("cancelEditBtn");

        editBtn.addEventListener("click", () => {
            displayBox.style.display = "none";
            formBox.style.display = "block";
            editBtn.style.display = "none";
        });

        cancelBtn.addEventListener("click", () => {
            formBox.style.display = "none";
            displayBox.style.display = "block";
            editBtn.style.display = "block";
        });
    </script>
}