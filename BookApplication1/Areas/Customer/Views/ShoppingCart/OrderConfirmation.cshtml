@model int

@{
    ViewData["Title"] = "Order Confirmed";
}

<style>
    .confirm-wrapper {
        max-width: 850px;
        margin: 3rem auto;
        text-align: center;
    }

    .confirm-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 0;
        padding: 2.5rem;
    }

    .confirm-icon {
        font-size: 4.5rem;
        color: #198754;
        margin-bottom: 1rem;
    }

    .heading-main {
        font-weight: 800;
        text-transform: uppercase;
    }

    .info-text {
        font-size: 1rem;
        color: #6c757d;
        margin-bottom: 2rem;
    }

    .action-btns a {
        min-width: 180px;
    }
</style>


<div class="confirm-wrapper">

    <div class="confirm-card">

        <div class="confirm-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>

        <h2 class="heading-main mb-3">Order Confirmed</h2>

        <p class="info-text">
            Your order has been placed successfully.
            You will receive a confirmation email shortly.
        </p>

        <div class="action-btns d-flex justify-content-center gap-3 mt-4">

            <a asp-controller="Home" asp-action="Index"
               class="btn btn-dark rounded-0 px-4 text-uppercase fw-bold">
                Continue Browsing
            </a>

            <a asp-controller="ShoppingCart" asp-action="Index"
               class="btn btn-outline-dark rounded-0 px-4 text-uppercase fw-bold">
                View Cart
            </a>

        </div>

    </div>

</div>
